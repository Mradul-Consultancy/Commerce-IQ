ENVIRONMENT=development

# Choose duckdb for local demos or postgres for a PostgreSQL deployment.
DB_ENGINE=duckdb
DB_HOST=localhost
DB_PORT=5432
DB_NAME=commerceiq
DB_USER=postgres
DB_PASSWORD=your_password_here

API_URL=http://127.0.0.1:8000

# Set this for any public deployment. Requests must include X-API-Key.
API_KEY=

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
